# Hostinger (LiteSpeed/Apache). Raiz do site.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
# pastas internas não ficam públicas
RewriteRule ^(\.git|\.github|scripts|tests|node_modules)(/|$) - [F,L]
RewriteRule ^(package\.json|package-lock\.json|README\.md)$ - [F,L]
# o painel de resultados fica em /resultados/ (os arquivos continuam na raiz). O endereço antigo (/apuracao-2t-2026, com ou sem acento) redireciona para o novo.
RewriteRule ^apura(c|ç)(a|ã)o-2t-2026(/.*)?$ /resultados$3 [R=301,L,NE]
# versão de testes (conta, cadastro e IA): mesmos arquivos, endereço separado e fora do Google
RewriteRule ^resultados/teste$ /resultados/teste/ [R=301,L]
RewriteRule ^resultados/teste/$ painel.html [L]
RewriteRule ^resultados/teste/(.+)$ $1 [L]
RewriteRule ^resultados$ /resultados/ [R=301,L]
RewriteRule ^resultados/$ painel.html [L]
RewriteRule ^resultados/(.+)$ $1 [L]
# placar ao vivo e resultado por seção passam pelo intermediário (cópia curta em cache)
RewriteRule ^live/(.+)$ api/live.php?p=$1 [L,QSA]
RewriteRule ^liveb/([1-5])/(.+)$ api/live.php?b=$1&p=$2 [L,QSA]
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
AddType application/manifest+json .webmanifest
<FilesMatch "\.(png|jpg|jpeg|svg|webp|woff2)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
<FilesMatch "^(index|painel|admin|privacidade|termos)\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<If "%{REQUEST_URI} =~ m#^/resultados/teste#">
Header set X-Robots-Tag "noindex, nofollow"
</If>
<If "%{REQUEST_URI} =~ m#^/data/(?!live/)#">
Header set Cache-Control "public, max-age=3600"
</If>
</IfModule>
